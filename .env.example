# DEVELOPMENT / DEPLOYMENT SERVER VARIABLES
# Shared Supabase PostgreSQL Session Pooler connection URL (port 5432, sslmode=require).
# Replace <PROJECT_REF>, <DB_PASSWORD>, and <SESSION_POOLER_HOST> with privately supplied team credentials.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require&connection_limit=3&pool_timeout=30"

# Use three different cryptographically random values of at least 32 characters (shared team secret or local development secret).
JWT_SECRET="replace-with-a-unique-session-signing-secret-min-32-chars"
QR_SECRET="replace-with-a-different-qr-signing-secret-min-32-chars"
REALTIME_SERVICE_SECRET="replace-with-a-different-realtime-service-secret-min-32-chars"

# Standalone Socket.io service used only by server-side publication.
REALTIME_URL="http://localhost:4000"

# Browser-visible Socket.io endpoint. Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"

# GOOGLE STUDENT SSO
# Browser-visible OAuth Web Client ID (not a secret). The same value is used
# server-side as the required ID-token audience.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Authoritative Workspace hosted-domain claim required by the backend.
GOOGLE_STUDENT_HOSTED_DOMAIN="student.tarc.edu.my"

# DEMO AUTH
# Both gates default off. Enable both explicitly only for local development
# when the seeded LEGACY_PROTOTYPE Student password login is required.
NEXT_PUBLIC_DEMO_MODE="false"
DEMO_STUDENT_PASSWORD_LOGIN_ENABLED="false"

# Standalone realtime-process settings (not read by the browser bundle).
CORS_ORIGIN="http://localhost:3000"
NEXTJS_INTERNAL_URL="http://localhost:3000"
# Schedulers & GPS simulator execution flag.
# Default is "false" for normal teammate development to prevent duplicate cron/simulator writes against the shared Supabase DB.
# Set to "true" ONLY on the ONE designated operator/demo machine.
RUN_SCHEDULED_JOBS="false"
# Optional overrides; defaults are 4000 and the central 5000 ms policy.
# REALTIME_PORT="4000"
# GPS_SIMULATOR_INTERVAL_MS="5000"

# CI / INTEGRATION TEST ONLY (dedicated separate database). Tests fail closed unless both are explicitly set.
# Never configure these as normal requirements or point them at the shared DATABASE_URL.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fyp_bus_test?schema=public"
# TEST_DATABASE_CONFIRM="FYP_BUS_INTEGRATION"

# GOOGLE MAPS PLATFORM ROUTES API (Traffic-Aware Shuttle ETA Integration)
# Kept strictly server-side. Never expose via NEXT_PUBLIC_*.
# Disabled by default so normal teammate development and CI incur zero Google API costs.
# Falls back gracefully to SCHEDULE_ESTIMATE when false or when key is missing.
GOOGLE_TRAFFIC_ETA_ENABLED="false"
GOOGLE_MAPS_ROUTES_API_KEY=""

# OPTIONAL BROWSER MAP (separate key from the server Routes API key)
# This value is intentionally browser-visible. Restrict it in Google Cloud to
# the Maps JavaScript API and exact HTTPS application referrers/origins.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# OPTIONAL GEMINI OPERATIONS INTELLIGENCE (SERVER ONLY)
# Deterministic metrics, signals, charts, and focus remain available when false.
# Use a restricted server-side Gemini API key; never rename this to NEXT_PUBLIC_*.
GEMINI_OPERATIONS_ASSISTANT_ENABLED="false"
GEMINI_API_KEY=""
# Stable GA Flash model verified against current Google documentation.
GEMINI_MODEL="gemini-3.8-flash"

# TRANSACTIONAL EMAIL
# Development/test returns one-time preview links without sending. Production
# requires both server-only Resend settings and fails closed when either is
# absent. EMAIL_FROM must use a sender/domain controlled by the operator and
# verified in Resend; do not impersonate a TAR UMT-owned domain.
RESEND_API_KEY=""
EMAIL_FROM=""
APP_BASE_URL="http://localhost:3000"
