# Durable PostgreSQL development database (never use the integration database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fyp_bus_system?schema=public"

# Use three different cryptographically random values of at least 32 characters.
JWT_SECRET="replace-with-a-unique-session-signing-secret"
QR_SECRET="replace-with-a-different-qr-signing-secret"
REALTIME_SERVICE_SECRET="replace-with-a-different-realtime-service-secret"

# Standalone Socket.io service used only by server-side publication.
REALTIME_URL="http://localhost:4000"

# Browser-visible Socket.io endpoint. Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"

# Standalone realtime-process settings (not read by the browser bundle).
CORS_ORIGIN="http://localhost:3000"
NEXTJS_INTERNAL_URL="http://localhost:3000"

# Integration tests are opt-in and fail closed. Do not put these in normal .env.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fyp_bus_test?schema=public"
# TEST_DATABASE_CONFIRM="FYP_BUS_INTEGRATION"
