{
  "name": "fyp-bus-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests/specification tests/unit tests/integration tests/architecture scripts/*.ts --no-error-on-unmatched-pattern --max-warnings=0",
    "lint:legacy": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "test": "npm run test:unit",
    "test:unit": "node --conditions=react-server --import tsx --test tests/specification/*.test.ts tests/unit/shared/*.test.ts tests/unit/fleet/*.test.ts tests/unit/trips/*.test.ts tests/unit/bookings/*.test.ts tests/unit/boarding/*.test.ts tests/unit/penalties/*.test.ts tests/unit/location/*.test.ts tests/unit/analytics/*.test.ts tests/unit/realtime/*.test.ts",
    "test:integration": "node --import tsx scripts/run-integration-tests.ts",
    "test:architecture": "node --import tsx --test tests/architecture/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:architecture",
    "db:seed": "tsx prisma/seed.ts",
    "realtime": "node realtime/server.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.0",
    "server-only": "0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
