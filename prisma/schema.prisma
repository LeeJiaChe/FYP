datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  DRIVER
  ADMIN
}

enum BusStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum TripStatus {
  NOT_STARTED
  BOARDING
  DEPARTED
  ARRIVED
  DELAYED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  CHECKED_IN
  NO_SHOW
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  WAITLISTED
}

enum CheckInMethod {
  QR
  MANUAL
}

enum PenaltyStatus {
  ACTIVE
  APPEALED
  OVERTURNED
  UPHELD
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  BOOKING_CONFIRMED
  DEPARTURE_REMINDER
  CANCELLED
  NO_SHOW
  WAITLIST_PROMOTED
  PENALTY_ISSUED
  APPEAL_RESOLVED
  TRIP_DELAYED
}

enum DeviceSignal {
  OK
  OFFLINE
  ERROR
}

model User {
  id                  String   @id @default(uuid())
  studentId           String?  @unique
  name                String
  email               String   @unique
  passwordHash        String
  role                UserRole
  creditScore         Int      @default(100)
  isBookingRestricted Boolean  @default(false)
  sessionVersion      Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  driverTrips     Trip[]          @relation("DriverTrips")
  bookings        Booking[]
  penalties       Penalty[]
  appeals         PenaltyAppeal[]
  reviewedAppeals PenaltyAppeal[] @relation("AdminReviewedAppeals")
  notifications   Notification[]
}

model Bus {
  id               String    @id @default(uuid())
  plateNumber      String    @unique
  seatedCapacity   Int
  standingCapacity Int
  status           BusStatus @default(ACTIVE)
  deletedAt        DateTime?
  trips            Trip[]
}

model Route {
  id         String      @id @default(uuid())
  name       String
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  routeStops RouteStop[]
  trips      Trip[]
}

model Stop {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique
  name       String
  latitude   Decimal     @db.Decimal(9, 6)
  longitude  Decimal     @db.Decimal(9, 6)
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  routeStops RouteStop[]
  tripStops  TripStop[]
}

model RouteStop {
  id                          String @id @default(uuid()) @db.Uuid
  routeId                     String
  route                       Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId                      String @db.Uuid
  stop                        Stop   @relation(fields: [stopId], references: [id], onDelete: Restrict)
  position                    Int
  travelDurationToNextMinutes Int?

  @@unique([routeId, position])
  @@unique([routeId, stopId])
}

model Trip {
  id                   String     @id @default(uuid())
  routeId              String
  route                Route      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  busId                String
  bus                  Bus        @relation(fields: [busId], references: [id], onDelete: Restrict)
  driverId             String?
  driver               User?      @relation("DriverTrips", fields: [driverId], references: [id], onDelete: SetNull)
  departureTime        DateTime
  estimatedArrivalTime DateTime
  boardingDeadline     DateTime
  seatedCapacity       Int
  standingCapacity     Int
  status               TripStatus @default(NOT_STARTED)
  delayReason          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  seats        Seat[]
  tripSeats    TripSeat[]
  tripStops    TripStop[]
  tripSegments TripSegment[]
  bookings     Booking[]

  @@index([routeId])
  @@index([busId])
  @@index([driverId])
  @@index([departureTime])
  @@index([status])
  @@index([routeId, departureTime])
  @@index([driverId, departureTime])
}

model TripStop {
  id               String    @id @default(uuid()) @db.Uuid
  tripId           String
  trip             Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stopId           String    @db.Uuid
  stop             Stop      @relation(fields: [stopId], references: [id], onDelete: Restrict)
  position         Int
  stopCode         String
  stopName         String
  latitude         Decimal   @db.Decimal(9, 6)
  longitude        Decimal   @db.Decimal(9, 6)
  plannedArrival   DateTime
  plannedDeparture DateTime
  boardingDeadline DateTime
  actualArrival    DateTime?
  actualDeparture  DateTime?
  passedAt         DateTime?

  segmentsFrom TripSegment[] @relation("TripSegmentFrom")
  segmentsTo   TripSegment[] @relation("TripSegmentTo")

  @@unique([tripId, position])
  @@unique([tripId, stopId])
  @@unique([tripId, id])
  @@index([stopId, plannedDeparture])
}

model TripSegment {
  id             String   @id @default(uuid()) @db.Uuid
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position       Int
  fromTripStopId String   @db.Uuid
  fromTripStop   TripStop @relation("TripSegmentFrom", fields: [fromTripStopId], references: [id], onDelete: Cascade)
  toTripStopId   String   @db.Uuid
  toTripStop     TripStop @relation("TripSegmentTo", fields: [toTripStopId], references: [id], onDelete: Cascade)

  @@unique([tripId, position])
  @@unique([tripId, fromTripStopId, toTripStopId])
}

model TripSeat {
  id         String @id @default(uuid()) @db.Uuid
  tripId     String
  trip       Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatNumber Int
  legacySeat Seat?  @relation("LegacySeatInventory")

  @@unique([tripId, seatNumber])
}

model Seat {
  id         String            @id @default(uuid())
  tripId     String
  trip       Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripSeatId String?           @unique @db.Uuid
  tripSeat   TripSeat?         @relation("LegacySeatInventory", fields: [tripSeatId], references: [id], onDelete: SetNull)
  seatNumber Int
  status     SeatStatus        @default(AVAILABLE)
  booking    Booking?
  deviceLogs DeviceStatusLog[]

  @@unique([tripId, seatNumber])
  @@index([tripId])
}

model Booking {
  id               String         @id @default(uuid())
  studentId        String
  student          User           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  tripId           String
  trip             Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatId           String?        @unique
  seat             Seat?          @relation(fields: [seatId], references: [id], onDelete: SetNull)
  status           BookingStatus  @default(CONFIRMED)
  waitlistPosition Int?
  checkInMethod    CheckInMethod?
  qrTokenIssuedAt  DateTime?
  checkedInAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  penalties Penalty[]

  @@unique([tripId, waitlistPosition])
  @@index([studentId])
  @@index([tripId])
  @@index([status])
}

model Penalty {
  id                   String        @id @default(uuid())
  bookingId            String
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId            String
  student              User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  creditPointsDeducted Int           @default(15)
  reason               String        @default("No-show")
  status               PenaltyStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())

  appeals PenaltyAppeal[]

  @@index([bookingId])
  @@index([studentId])
}

model PenaltyAppeal {
  id                String       @id @default(uuid())
  penaltyId         String       @unique
  penalty           Penalty      @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  studentId         String
  student           User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason            String
  status            AppealStatus @default(PENDING)
  reviewedByAdminId String?
  reviewedByAdmin   User?        @relation("AdminReviewedAppeals", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  adminComment      String?
  createdAt         DateTime     @default(now())
  resolvedAt        DateTime?

  @@index([studentId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model DeviceStatusLog {
  id              String       @id @default(uuid())
  seatId          String
  seat            Seat         @relation(fields: [seatId], references: [id], onDelete: Cascade)
  simulatedSignal DeviceSignal @default(OK)
  recordedAt      DateTime     @default(now())

  @@index([seatId])
}
